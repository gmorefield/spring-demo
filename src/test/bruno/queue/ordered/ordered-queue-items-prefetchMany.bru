meta {
  name: ordered-queue-items-prefetchMany
  type: http
  seq: 3
}

get {
  url: {{host}}/queue/order/manyPrefetch?threads=10&prefetch=90&errorRate=0&fetchType=SELECT_SUB_SELECT
  body: none
  auth: inherit
}

params:query {
  threads: 10
  prefetch: 90
  errorRate: 0
  fetchType: SELECT_SUB_SELECT
  ~fetchType: SELECT_PARTITION
  ~fetchType: SELECT_JOIN
}

settings {
  encodeUrl: true
  timeout: 0
}
