meta {
  name: ordered-queue-items-prefetchMany
  type: http
  seq: 3
}

get {
  url: {{host}}/queue/order/manyPrefetch?threads=10&prefetch=30
  body: none
  auth: inherit
}

params:query {
  threads: 10
  prefetch: 30
  ~errorRate: 0
  ~fetchType: SELECT_PARTITION
  ~fetchType: SELECT_SUB_SELECT
}

settings {
  encodeUrl: true
  timeout: 0
}
