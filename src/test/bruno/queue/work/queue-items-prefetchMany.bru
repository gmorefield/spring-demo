meta {
  name: queue-items-prefetchMany
  type: http
  seq: 2
}

get {
  url: {{host}}/queue/manyPrefetch?threads=10&prefetch=90&errorRate=1&useFetch=true
  body: none
  auth: inherit
}

params:query {
  threads: 10
  prefetch: 90
  errorRate: 1
  useFetch: true
}

settings {
  encodeUrl: true
  timeout: 0
}
